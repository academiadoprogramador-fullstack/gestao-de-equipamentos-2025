<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Gestão de Equipamentos</title>

    <style>
        :root {
            --fundo-principal: #1e1e1e;
            --fundo-secundario: #2c2c2e;

            --cor-borda: #3a3a3c;
        }

        body {
            margin: 0;
            background-color: var(--fundo-principal);
            color: white;

            font-family: 'Segoe UI', sans-serif;
        }

        a {
            text-decoration: none;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 100px;

            justify-content: space-between;

            padding: 0 200px;
            background-color: var(--fundo-secundario);

            border-bottom: 1px solid var(--cor-borda);
        }

        nav > h2 {
            margin: 0;
        }

        nav > ul {
            display: flex;
            gap: 30px;

            list-style: none;
        }

        .link-navegacao {
            color: #DB56EB;

            text-decoration: none;

            font-weight: 500;
            font-size: 18px;
        }

        header {
            padding: 0 200px;
        }

        main { 
            /* padding: vertical horizontal; */
            /* padding: top right bottom left; */
            padding: 0 200px;

            display: flex;
            flex-wrap: wrap;
            gap: 30px;
        }

        .card {
            border: 1px solid var(--cor-borda);
            border-radius: 15px;

            padding: 0 10px;

            width: 350px;
            height: 150px;
            background-color: var(--fundo-secundario);
        }

        .card h3 {
            color: #DB56EB;
        }


        .card p {
            color: #ffffff;
        }
    </style>

</head>
<body>
    <nav>
        <h2>Gestão de Equipamentos</h2>

        <ul>
            <li><a class="link-navegacao" href="/">Página Inicial</a></li>
            <li><a class="link-navegacao" href="/fabricantes/visualizar">Fabricantes</a></li>
            <li><a class="link-navegacao" href="/equipamentos/visualizar">Equipamentos</a></li>
            <li><a class="link-navegacao" href="/chamados/visualizar">Chamados</a></li>
        </ul>
    </nav>

    <header>
        <h3>Página Inicial</h3>
    </header>

    <main>
        <a href="/fabricantes/visualizar">
            <div class="card">
                <h3>Fabricantes</h3>

                <p>Gerencie os Fabricantes de Equipamentos</p>
            </div>
        </a>

        <a href="/equipamentos/visualizar">
            <div class="card">
                <h3>Equipamentos</h3>

                <p>Gerencie os Equipamentos</p>
            </div>
        </a>

        <a href="/chamados/visualizar">
            <div class="card">
                <h3>Chamados</h3>

                <p>Gerencie os Chamados de Manutenção</p>
            </div>
        </a>

    </main>
    </body>
</html>